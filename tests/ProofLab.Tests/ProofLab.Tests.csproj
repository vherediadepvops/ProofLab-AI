<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ProofLab.Science\ProofLab.Science.csproj" />
    <!-- Pure, network-free SAM SSE reader compiled into the test assembly.
         Avoids enabling any Meta API test credentials or paid calls. -->
    <Compile Include="..\..\src\ProofLab.Api\SamVideoSseParser.cs"
             Link="SamVideoSseParser.cs" />
    <Compile Include="..\..\src\ProofLab.Api\SamManualApiTokenPolicy.cs"
             Link="SamManualApiTokenPolicy.cs" />
    <Compile Include="..\..\src\ProofLab.Api\SamVideoEvidenceIndex.cs"
             Link="SamVideoEvidenceIndex.cs" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="..\..\src\ProofLab.Api\MetaLiveAccess.cs" Link="MetaLiveAccess.cs" />
    <!-- Real orchestration and archive code; all external dependencies are
         fake in integration tests. No production transport or credentials. -->
    <Compile Include="..\..\src\ProofLab.Api\SamVideoContracts.cs" Link="SamVideoContracts.cs" />
    <Compile Include="..\..\src\ProofLab.Api\VideoTimingCatalog.cs" Link="VideoTimingCatalog.cs" />
    <Compile Include="..\..\src\ProofLab.Api\SamVideoArchive.cs" Link="SamVideoArchive.cs" />
    <Compile Include="..\..\src\ProofLab.Api\PendulumSamCache.cs" Link="PendulumSamCache.cs" />
    <Compile Include="..\..\src\ProofLab.Api\SamManualOneShotRequest.cs" Link="SamManualOneShotRequest.cs" />
    <!-- Knot transport tests inject a fake HTTP handler; never a live credential. -->
    <Compile Include="..\..\src\ProofLab.Api\KnotContracts.cs" Link="KnotContracts.cs" />
    <Compile Include="..\..\src\ProofLab.Api\KnotMetaTransport.cs" Link="KnotMetaTransport.cs" />
    <Compile Include="..\..\src\ProofLab.Api\PendulumKnotLocator.cs" Link="PendulumKnotLocator.cs" />
    <Compile Include="..\..\src\ProofLab.Api\AssemblyContracts.cs" Link="AssemblyContracts.cs" />
    <Compile Include="..\..\src\ProofLab.Api\AssemblyMetaTransport.cs" Link="AssemblyMetaTransport.cs" />
    <Compile Include="..\..\src\ProofLab.Api\AssemblyLocator.cs" Link="AssemblyLocator.cs" />
    <Compile Include="..\..\src\ProofLab.Api\SuspensionReview.cs" Link="SuspensionReview.cs" />
    <Compile Include="..\..\src\ProofLab.Api\AssemblyVideoGrounding.cs" Link="AssemblyVideoGrounding.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\ProofLab.Api\MuseExperimentContracts.cs" Link="MuseExperimentContracts.cs" />
    <Compile Include="..\..\src\ProofLab.Api\MuseExperimentStore.cs" Link="MuseExperimentStore.cs" />
    <Compile Include="..\..\src\ProofLab.Api\MuseExperimentTransport.cs" Link="MuseExperimentTransport.cs" />
  </ItemGroup>
</Project>
