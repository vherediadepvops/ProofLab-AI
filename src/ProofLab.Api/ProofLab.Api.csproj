<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ProofLab.Science\ProofLab.Science.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <EmbeddedResource Include="Database\001_scientific_experience.sql"
                      LogicalName="ProofLab.Api.Database.ScientificExperienceSchemaV1.sql" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Workers\sam-period-worker.cjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildSamPeriodWorker" BeforeTargets="BeforeBuild"
          Inputs="../../scripts/sam-period-worker.ts;../../scripts/build-sam-period-worker.cjs;../../ui/src/app/sam-period.ts;../../ui/src/app/sam-suspension.ts;../../ui/src/app/sam-playback.ts;../../ui/src/app/sam-video-evidence.ts;../../ui/src/app/pendulum-kinematics.ts;../../ui/package-lock.json"
          Outputs="Workers/sam-period-worker.cjs">
    <Exec Command="node &quot;../../scripts/build-sam-period-worker.cjs&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <ItemGroup>
    <Content Include="Workers\sam-seam-worker.cjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildSamSeamWorker" BeforeTargets="BeforeBuild"
          Inputs="../../scripts/sam-seam-worker.ts;../../scripts/build-sam-seam-worker.cjs;../../ui/package-lock.json"
          Outputs="Workers/sam-seam-worker.cjs">
    <Exec Command="node &quot;../../scripts/build-sam-seam-worker.cjs&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
